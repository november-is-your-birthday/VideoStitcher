<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 品牌标题区：大字号轻量字重 + 小标签，安静克制 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.02"
                android:text="批量视频拼接器"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_info"
                android:paddingLeft="10dp"
                android:paddingTop="3dp"
                android:paddingRight="10dp"
                android:paddingBottom="3dp"
                android:text="无损优先"
                android:textColor="@color/brand_on_primary_container"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="秒拼 · 画质零损失 · 纯本地"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 三入口：等宽胶囊，图标+主词，去掉长句 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewGroup"
            style="@style/Widget.VideoStitcher.Entry"
            android:layout_width="0dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="从文件夹导入"
             />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlbumPick"
            style="@style/Widget.VideoStitcher.Entry"
            android:layout_width="0dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="从相册选"
             />
    </LinearLayout>

    <!-- 输出设置入口（仅影响需要转码的分组，无损拼接永远原画质）：
         与上面两个入口同样的圆角方框样式，放在显眼位置 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOutputSettings"
        style="@style/Widget.VideoStitcher.Entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="输出设置：原尺寸 · 自动跟随源"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/scrollGroups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </ScrollView>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:padding="32dp"
        android:text="还没有分组\n\n从文件夹导入一组视频\n或从相册挑选视频新建分组"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 底部操作区：主按钮占满 + 状态一行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp">

        <ProgressBar
            android:id="@+id/pbOverall"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:progressDrawable="@drawable/progress_thin"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="18dp"
            android:text="准备就绪"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brand_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="开始拼接"
            android:textColor="@color/brand_on_primary"
            android:textSize="16sp"
            android:textStyle="bold"
             />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenOutput"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="打开相册查看成品"
            android:textSize="13sp"
            android:visibility="gone"
            
             />
    </LinearLayout>
</LinearLayout>
