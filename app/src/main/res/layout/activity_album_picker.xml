<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp">

        <TextView
            android:id="@+id/tvAlbumTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="从相册选择（已选 0 个）"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnViewMode"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="▦ 大图"
            android:textSize="13sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/listAlbum"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <GridView
        android:id="@+id/gridAlbum"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="2"
        android:stretchMode="columnWidth"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAlbumEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="没有找到视频。\n\n如果未授予视频权限，请到系统设置里允许后重试；\n藏在特殊目录的视频请改用「从文件夹导入」。"
        android:textColor="#888888"
        android:textSize="15sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnAlbumConfirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="12dp"
        android:enabled="false"
        android:text="添加所选到新分组"
        android:textSize="16sp" />
</LinearLayout>
